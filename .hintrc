{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-text-size-adjust",
          "scrollbar-width",
          "scrollbar-width: none",
          "scrollbar-gutter",
          "scrollbar-gutter: auto",
          "scrollbar-color",
          "scrollbar-gutter: stable",
          "scrollbar-width: thin"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}